// Windows resource script for Versionary. Configured by CMake from
// Versionary.rc.in (see CMakeLists.txt); Versionary.ico is copied next to the
// generated file so the path stays trivial for rc.exe.
#include <windows.h>

IDI_ICON1 ICON "Versionary.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSIONARY_VERSION_COMMA@
 PRODUCTVERSION @VERSIONARY_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Spuk1\0"
            VALUE "FileDescription", "Versionary\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "Versionary\0"
            VALUE "OriginalFilename", "Versionary.exe\0"
            VALUE "ProductName", "Versionary\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
            VALUE "LegalCopyright", "GPL-3.0-or-later\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
