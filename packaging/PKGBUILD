# Maintainer: Leon <leontieber@gmx.net>
pkgname=versionary-qt-git
pkgver=1.0.0.r0.g0000000
pkgrel=1
pkgdesc="A fast, native Qt Git GUI client"
arch=('x86_64')
url="https://github.com/spuk1/versionary"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'git' 'hicolor-icon-theme' 'desktop-file-utils')
makedepends=('git' 'cmake' 'gcc')
provides=('versionary-qt')
conflicts=('versionary-qt')
source=("$pkgname::git+https://github.com/spuk1/versionary-qt.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "1.0.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  # OAuth credentials baked into the binary (optional but needed for
  # login to work out of the box). Provide them either as environment
  # variables or via a dotenv-style .env file next to this PKGBUILD —
  # the file itself is never packaged.
  dotenv_get() {
    [ -f .env ] || return 0
    grep -E "^[[:space:]]*$1[[:space:]]*=" .env | tail -1 \
      | sed -E "s/^[^=]*=[[:space:]]*['\"]?//;s/['\"]?[[:space:]]*$//"
  }
  cmake -S "$pkgname" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DVERSIONARY_GITHUB_CLIENT_ID="${VERSIONARY_GITHUB_CLIENT_ID:-$(dotenv_get GITHUB_CLIENT_ID)}" \
    -DVERSIONARY_GITHUB_CLIENT_SECRET="${VERSIONARY_GITHUB_CLIENT_SECRET:-$(dotenv_get CLIENT_GITHUB_SECRET)}" \
    -DVERSIONARY_BITBUCKET_CLIENT_ID="${VERSIONARY_BITBUCKET_CLIENT_ID:-$(dotenv_get BITBUCKET_CLIENT_ID)}" \
    -DVERSIONARY_BITBUCKET_CLIENT_SECRET="${VERSIONARY_BITBUCKET_CLIENT_SECRET:-$(dotenv_get CLIENT_BITBUCKET_SECRET)}" \
    -DVERSIONARY_GITLAB_CLIENT_ID="${VERSIONARY_GITLAB_CLIENT_ID:-$(dotenv_get GITLAB_CLIENT_ID)}" \
    -DVERSIONARY_GITLAB_CLIENT_SECRET="${VERSIONARY_GITLAB_CLIENT_SECRET:-$(dotenv_get CLIENT_GITLAB_SECRET)}"
  cmake --build build -j"$(nproc)"
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
